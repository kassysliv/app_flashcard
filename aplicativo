#tela inicial aonde contem layout principal o titulo, a frase motivacional
class TelaInicial(MDScreen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        layout = MDBoxLayout(
            orientation="vertical",
            padding=40,
            spacing=30,
        )

        titulo = MDLabel(
            text="FlashCards",
            halign="center",
            font_style="H4",
            bold=True,
        )

        frase = MDLabel(
            text="Estude e aprenda!",
            halign="center",
            font_style="Subtitle1",
            theme_text_color="Secondary"
        )

        botao = MDRaisedButton(
            text="Começar",
            pos_hint={"center_x": 0.5},
            on_release=self.ir_para_cadastro
