# ------------------- App Principal -------------------
class AplicativoCartoes(MDApp):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.lista_materias = []  # Lista global para armazenar matérias
        self.materias_flashcards = {}  # {"materia": [(pergunta, resposta), ...]}
        self.store = JsonStore(" usuario.json")
    def build(self):
        self.theme_cls.primary_palette = "Indigo"
        self.theme_cls.theme_style = "Dark"

        self.gerenciador = ScreenManager(transition=FadeTransition())
        self.gerenciador.add_widget(TelaInicial(name="tela_inicial"))
        self.gerenciador.add_widget(TelaCadastro(name="tela_cadastro"))
        self.gerenciador.add_widget(TelaJogoInicio(name="tela_jogo_inicio"))
        self.gerenciador.add_widget(TelaJogo(name="tela_jogo"))
        self.gerenciador.add_widget(TelaAdicionarMateria(name="tela_adicionar_materia"))
        self.gerenciador.add_widget(TelaMaterias(name="tela_materias"))

        if self.store.exists("usuario"):
            self.gerenciador.current = "tela_jogo_inicio"
        else:
            self.gerenciador.current = "tela_inicial"
        return self.gerenciador


if __name__ == "__main__":
    AplicativoCartoes().run()
