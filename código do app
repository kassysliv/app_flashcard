from kivymd.uix.button import MDIconButton  # Certifique-se que está importado

class TelaMaterias(MDScreen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        self.layout_principal = MDBoxLayout(orientation="vertical", padding=30, spacing=20)

        titulo = MDLabel(
            text="Matérias",
            halign="center",
            font_style="H5",
            bold=True,
        )

        self.container_lista = MDBoxLayout(
            orientation="vertical",
            spacing=10,
            size_hint_y=None
        )
        self.container_lista.bind(minimum_height=self.container_lista.setter("height"))

        scroll = ScrollView()
        scroll.add_widget(self.container_lista)

        botao_voltar = MDRaisedButton(
            text="Voltar",
            pos_hint={"center_x": 0.5},
            on_release=self.voltar_tela_anterior
        )

        self.layout_principal.add_widget(titulo)
        self.layout_principal.add_widget(scroll)
        self.layout_principal.add_widget(botao_voltar)

        self.add_widget(self.layout_principal)

    def on_pre_enter(self, *args):
        self.atualizar_lista()

    def atualizar_lista(self):
        self.container_lista.clear_widgets()
        app = MDApp.get_running_app()
        for materia in app.lista_materias:
            flashcards = app.materias_flashcards.get(materia, [])

            # Card da matéria com botão de deletar
            card = MDCard(
                size_hint_y=None,
                height=80 + len(flashcards) * 70,
                radius=[10, 10, 10, 10],
                padding=10,
                md_bg_color=(0.25, 0.25, 0.5, 1),
                orientation="vertical"
            )

            # Linha superior: nome da matéria + botão deletar
            linha_topo = MDBoxLayout(orientation="horizontal", size_hint_y=None, height=40)
            label = MDLabel(
                text=materia,
                halign="left",
                valign="middle",
                theme_text_color="Custom",
                text_color=(1, 1, 1, 1),
                font_style="H6"
            )
            botao_remover = MDIconButton(
                icon="delete",
                theme_text_color="Custom",
                text_color=(1, 0.4, 0.4, 1),
                on_release=lambda x, m=materia: self.remover_materia(m)
            )
            linha_topo.add_widget(label)
            linha_topo.add_widget(botao_remover)
            card.add_widget(linha_topo)

            # Adicionar perguntas e respostas (resposta abaixo da pergunta)
            for pergunta, resposta in flashcards:
                pergunta_label = MDLabel(
                    text=f"• {pergunta}",
                    halign="left",
                    theme_text_color="Custom",
                    text_color=(1, 1, 1, 1),
                    font_style="Body1"
                )
                resposta_label = MDLabel(
                    text=f"  → {resposta}",
                    halign="left",
                    theme_text_color="Custom",
                    text_color=(0.8, 1, 0.8, 1),
                    font_style="Body2"
                )
                card.add_widget(pergunta_label)
                card.add_widget(resposta_label)

            self.container_lista.add_widget(card)

    def remover_materia(self, nome_materia):
        app = MDApp.get_running_app()
        if nome_materia in app.lista_materias:
            app.lista_materias.remove(nome_materia)
        if nome_materia in app.materias_flashcards:
            del app.materias_flashcards[nome_materia]
        self.atualizar_lista()

    def voltar_tela_anterior(self, instancia):
        self.manager.current = "tela_jogo_inicio"



