# ------------------- Tela Adicionar Matéria -------------------
class TelaAdicionarMateria(MDScreen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        layout = MDBoxLayout(orientation="vertical", padding=30, spacing=20)

        titulo = MDLabel(
            text="Adicionar Matéria",
            halign="center",
            font_style="H5",
            bold=True,
        )

        self.campo_materia = MDTextField(
            hint_text="Nome da matéria",
            mode="rectangle"
        )

        # Novos campos para pergunta e resposta
        self.campo_pergunta = MDTextField(
            hint_text="Pergunta do flashcard",
            mode="rectangle"
        )
        self.campo_resposta = MDTextField(
            hint_text="Resposta do flashcard",
            mode="rectangle"
        )

        botao_adicionar_flashcard = MDRaisedButton(
            text="Adicionar Pergunta/Resposta",
            pos_hint={"center_x": 0.5},
            on_release=self.adicionar_flashcard
        )

        botao_salvar = MDRaisedButton(
            text="Salvar Matéria",
            pos_hint={"center_x": 0.5},
            on_release=self.salvar_materia
        )

        botao_voltar = MDRaisedButton(
            text="Voltar",
            pos_hint={"center_x": 0.5},
            on_release=self.voltar_tela_anterior
        )

        layout.add_widget(titulo)
        layout.add_widget(self.campo_materia)
        layout.add_widget(self.campo_pergunta)
        layout.add_widget(self.campo_resposta)
        layout.add_widget(botao_adicionar_flashcard)
        layout.add_widget(botao_salvar)
        layout.add_widget(botao_voltar)

        self.add_widget(layout)

        # Lista temporária de flashcards para essa matéria
        self.flashcards = []

    def adicionar_flashcard(self, instancia):
        pergunta = self.campo_pergunta.text.strip()
        resposta = self.campo_resposta.text.strip()
        if not pergunta or not resposta:
            MDDialog(title="Aviso", text="Digite a pergunta e a resposta.", size_hint=(0.8, 0.3)).open()
            return
        self.flashcards.append((pergunta, resposta))
        self.campo_pergunta.text = ""
        self.campo_resposta.text = ""
        MDDialog(title="Sucesso", text="Pergunta/Resposta adicionada!", size_hint=(0.8, 0.3)).open()

    def salvar_materia(self, instancia):
        materia = self.campo_materia.text.strip()
        if not materia:
            MDDialog(title="Aviso", text="Digite o nome da matéria.", size_hint=(0.8, 0.3)).open()
            return

        app = MDApp.get_running_app()
        if materia not in app.materias_flashcards:
            app.materias_flashcards[materia] = []
        app.materias_flashcards[materia].extend(self.flashcards)
        if materia not in app.lista_materias:
            app.lista_materias.append(materia)

        self.campo_materia.text = ""
        self.flashcards = []

        # Opcional: Mensagem de sucesso
        MDDialog(title="Sucesso", text=f"Matéria '{materia}' adicionada.", size_hint=(0.8, 0.3)).open()

    def voltar_tela_anterior(self, instancia):
        self.manager.current = "tela_jogo_inicio"

